/**
 * 引用 Android 系统库
 */
import AudioRecord from "android.media.AudioRecord";
import AudioFormat from "android.media.AudioFormat";
import MediaRecorder from "android.media.MediaRecorder";
import Thread from "java.lang.Thread";
import Runnable from "java.lang.Runnable";
import ByteBuffer from "java.nio.ByteBuffer";
import ByteOrder from "java.nio.ByteOrder";

/* 引入 interface.uts 文件中定义的变量 */
import { StartRecordOptions, StopRecordOptions, StartRecordResult, StopRecordResult, StartRecord, StopRecord, RecordConfig } from '../interface.uts';

/* 引入 unierror.uts 文件中定义的变量 */
import { RecordFailImpl } from '../unierror';

/**
 * UTSAndroid 为平台内置对象，不需要 import 可直接调用其API，[详见](https://uniapp.dcloud.net.cn/uts/utsandroid.html#utsandroid)
 */

// 全局变量
let audioRecord : AudioRecord | null = null;
let recordingThread : Thread | null = null;
let isRecording = false;
let frameCallback : ((data : ArrayBuffer, decibel : number) => void) | null = null;
let startTime = 0;
let recordFrameSize = 0;

/**
 * 获取音频格式
 */
function getAudioFormat(channels : number, bitsPerSample : number) : number {
	if (channels == 1) {
		return bitsPerSample == 8 ? AudioFormat.CHANNEL_IN_MONO : AudioFormat.CHANNEL_IN_MONO;
	} else {
		return bitsPerSample == 8 ? AudioFormat.CHANNEL_IN_STEREO : AudioFormat.CHANNEL_IN_STEREO;
	}
}

/**
 * 获取编码格式
 */
function getEncoding(bitsPerSample : number) : number {
	if (bitsPerSample == 8) {
		return AudioFormat.ENCODING_PCM_8BIT;
	} else if (bitsPerSample == 16) {
		return AudioFormat.ENCODING_PCM_16BIT;
	} else if (bitsPerSample == 24) {
		return AudioFormat.ENCODING_PCM_24BIT_PACKED;
	} else if (bitsPerSample == 32) {
		return AudioFormat.ENCODING_PCM_32BIT;
	} else {
		return AudioFormat.ENCODING_PCM_16BIT;
	}
}

/**
 * 检查并请求录音权限
 */
function checkPermission() : boolean {
	const context = UTSAndroid.getUniActivity();
	if (context == null) {
		return false;
	}
	const permission = "android.permission.RECORD_AUDIO";
	const checkResult = context.checkSelfPermission(permission);
	
	// 如果已有权限，直接返回 true
	if (checkResult == 0) { // PackageManager.PERMISSION_GRANTED = 0
		return true;
	}
	
	// 如果没有权限，进行申请
	const permissionNeed = [permission];
	UTSAndroid.requestSystemPermission(
		context, 
		permissionNeed, 
		function (allRight : boolean, _ : string[]) {
			// 权限申请成功回调
			if (allRight) {
				console.log('录音权限申请成功');
			} else {
				console.log('录音权限申请被拒绝');
			}
		}, 
		function (_1 : boolean, _2 : string[]) {
			// 权限申请失败回调
			console.log('录音权限申请失败或被拒绝');
		}
	);
	
	// 返回 false，因为权限申请是异步的，当前还没有权限
	return false;
}

/**
 * 计算音频数据的实时分贝值
 * @param arrayBuffer PCM 音频数据（16位，小端序）
 * @returns 分贝值（dB），范围通常在 -60 到 0 之间
 */
function calculateDecibel(arrayBuffer: ArrayBuffer): number {
	try {
		const dataView = new DataView(arrayBuffer);
		const length = arrayBuffer.byteLength;
		const sampleCount = length / 2; // 16位 = 2字节/样本
		
		if (sampleCount == 0) {
			return -Infinity; // 无数据，返回负无穷
		}
		
		let sumSquares = 0.0;
		
		// 计算 RMS (均方根)
		for (let i = 0; i < length; i += 2) {
			// 读取 16 位有符号整数（小端序）
			const sample = dataView.getInt16(i, true);
			// 归一化到 [-1, 1] 范围
			const normalized = sample / 32768.0;
			// 累加平方
			sumSquares += normalized * normalized;
		}
		
		// 计算 RMS
		const rms = Math.sqrt(sumSquares / sampleCount);
		
		// 避免 log(0) 的情况
		if (rms <= 0) {
			return -Infinity;
		}
		
		// 计算分贝值
		// 公式：dB = 20 * log10(rms / reference)
		// reference 通常为 1.0（最大振幅）
		const decibel = 20.0 * Math.log10(rms);
		
		return decibel;
	} catch (e: any) {
		console.error('计算分贝值失败:', e);
		return -Infinity;
	}
}

/**
 * 开始录音
 * @UTSJS.keepAlive 保持回调函数存活，避免跨线程调用时被释放
 */
@UTSJS.keepAlive
export function startRecord(options : StartRecordOptions) : void {
	try {
		// 检查权限
		if (!checkPermission()) {
			const err = new RecordFailImpl(9010001);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		// 如果正在录音，先停止
		if (isRecording && audioRecord != null) {
			stopRecord({});
		}

		// 配置参数
		const config : RecordConfig = options.config ?? {};
		const sampleRate = config.sampleRate ?? 16000;
		const channels = config.channels ?? 1;
		const bitsPerSample = config.bitsPerSample ?? 16;
		// 默认帧大小：每40ms发送1280字节
		// 计算：16000 Hz * 0.04秒 = 640样本，640样本 * 2字节/样本 = 1280字节
		const frameSize = config.frameSize ?? 640;

		// 计算声道配置
		const channelConfig = getAudioFormat(channels, bitsPerSample);
		const encoding = getEncoding(bitsPerSample);

		// 计算最小缓冲区大小
		const minBufferSize = AudioRecord.getMinBufferSize(sampleRate.toInt(), channelConfig.toInt(), encoding.toInt());
		if (minBufferSize == AudioRecord.ERROR_BAD_VALUE || minBufferSize == AudioRecord.ERROR) {
			const err = new RecordFailImpl(9010002);
			options.fail?.(err);
			options.complete?.(err);
			return;
		}

		// 使用较大的缓冲区大小
		const bufferSize = Math.max(minBufferSize, frameSize * 2).toInt();
		// console.log('bufferSize====>', bufferSize);
		// 创建AudioRecord
		const newAudioRecord = new AudioRecord(
			MediaRecorder.AudioSource.MIC,
			sampleRate.toInt(),
			channelConfig.toInt(),
			encoding.toInt(),
			bufferSize
		);

		// AudioRecord 构造函数不会返回 null，但可能状态不正确
		if (newAudioRecord.getState() != AudioRecord.STATE_INITIALIZED) {
			const err = new RecordFailImpl(9010002);
			options.fail?.(err);
			options.complete?.(err);
			audioRecord = null;
			return;
		}

		audioRecord = newAudioRecord;

		// 保存回调到全局变量（用于停止时清理）
		frameCallback = options.onFrame ?? null;
		isRecording = true;
		startTime = Date.now();

		// 开始录音
		newAudioRecord.startRecording();

		// 创建读取缓冲区
		recordFrameSize = frameSize.toInt();
		const readBufferSize = (recordFrameSize * 2).toInt();

		// 将回调函数作为闭包传递给线程（保持引用，避免被释放）
		// 直接从 options.onFrame 获取，@UTSJS.keepAlive 会保持其存活
		const callbackForThread = options.onFrame ?? null;

		// 创建读取线程
		class RecordRunnable implements Runnable {
			buffer : ByteBuffer;
			callback : ((data : ArrayBuffer, decibel : number) => void) | null;

			constructor(bufferSize : Int, callback : ((data : ArrayBuffer, decibel : number) => void) | null) {
				// AudioRecord.read() 需要直接分配的 ByteBuffer
				this.buffer = ByteBuffer.allocateDirect(bufferSize);
				// 设置字节序为小端序（Android AudioRecord 输出的是小端序 PCM 数据）
				this.buffer.order(ByteOrder.LITTLE_ENDIAN);
				this.callback = callback;
			}

			override run() : void {
				const localAudioRecord = audioRecord;
				const localFrameSize = recordFrameSize;
				const localCallback = this.callback;
				// console.log('调用回调====>run', isRecording);
				if (localAudioRecord == null) {
					return;
				}
				// localAudioRecord 在循环中不会变为 null，所以只需要检查 isRecording
				while (isRecording) {
					try {
						// AudioRecord.read返回读取的字节数
						// clear() 将 position 设为 0，limit 设为 capacity，准备写入
						this.buffer.clear();
						const readSize = (localFrameSize * 2).toInt();
						// read() 方法会将数据写入 ByteBuffer，并返回实际读取的字节数
						// 注意：read() 方法会修改 ByteBuffer 的 position（增加 bytesRead）
						const bytesRead = localAudioRecord.read(this.buffer, readSize);
						// console.log('==??==>', bytesRead, readSize, 'callback存在:', localCallback != null);
						if (bytesRead > 0) {
							if (localCallback != null) {
								// console.log('进入回调分支，准备处理数据，bytesRead:', bytesRead);
								try {
									// AudioRecord.read() 已将数据写入 ByteBuffer[0..bytesRead-1]
									// read() 后 position = bytesRead，需要重置为 0 以便读取
									
									// 16 位 PCM：每个样本 2 字节，确保 bytesRead 是偶数
									let actualBytesRead = bytesRead;
									if (bytesRead % 2 != 0) {
										console.log('警告：读取的字节数不是偶数，丢弃最后一个字节');
										actualBytesRead = bytesRead - 1;
									}
									
									// 设置 position 和 limit 为实际读取范围
									this.buffer.position(0);
									this.buffer.limit(actualBytesRead);

									// 使用 ArrayBuffer.fromByteBuffer() 将 ByteBuffer 转换为 ArrayBuffer
									// ByteBuffer 中的数据已经是 16 位 PCM 格式（小端序），转换后保持相同格式
									const arrayBuffer = ArrayBuffer.fromByteBuffer(this.buffer);
									
									// 计算实时分贝值
									const decibel = calculateDecibel(arrayBuffer);
									
									// 恢复 position 和 limit（虽然下次 clear() 会重置，但保持一致性）
									this.buffer.clear();
									
									// 确保回调不为 null 且 arrayBuffer 不为 null
									if (localCallback != null && arrayBuffer != null) {
										// console.log('调用回调====>', 'arrayBuffer大小:', arrayBuffer.byteLength, '样本数:', actualBytesRead / 2);
										// 调用回调，传递包含 16 位 PCM 音频数据的 ArrayBuffer 和分贝值
										localCallback(arrayBuffer, decibel);
									}
								} catch (e : any) {
									console.log('处理数据异常====>', e);
									// 异常时也清除 buffer 状态
									this.buffer.clear();
								}
							} else {
								console.log('回调为null，跳过处理');
							}
						} else if (bytesRead < 0) {
							// 读取错误（ERROR_INVALID_OPERATION, ERROR_BAD_VALUE 等）
							if (isRecording) {
								isRecording = false;
							}
							break;
						}
						// bytesRead == 0 的情况，继续循环
					} catch (e : any) {
						// 捕获异常，避免线程静默失败
						if (isRecording) {
							isRecording = false;
						}
						break;
					}
				}
			}
		}
		const runnable = new RecordRunnable(readBufferSize, callbackForThread);
		const newThread = new Thread(runnable);
		recordingThread = newThread;
		newThread.start();

		// 返回成功
		const res : StartRecordResult = {
			success: true,
			sampleRate: sampleRate,
			channels: channels,
			bitsPerSample: bitsPerSample
		};
		options.success?.(res);
		options.complete?.(res);

	} catch (e : any) {
		const err = new RecordFailImpl(9010003);
		options.fail?.(err);
		options.complete?.(err);
	}
}

/**
 * 停止录音
 */
export const stopRecord : StopRecord = function (options ?: StopRecordOptions) {
	// console.log('停止录音====>', isRecording, audioRecord);
	try {
		const localAudioRecord = audioRecord;

		// 如果 audioRecord 为 null，说明没有正在录音
		if (localAudioRecord == null) {
			const res : StopRecordResult = {
				success: false,
				duration: 0
			};
			options?.success?.(res);
			options?.complete?.(res);
			return;
		}

		// 先停止录音（停止数据采集）
		try {
			if (localAudioRecord.getRecordingState() == AudioRecord.RECORDSTATE_RECORDING) {
				localAudioRecord.stop();
				console.log('AudioRecord.stop() 已调用');
			}
		} catch (e : any) {
			// 忽略停止时的异常
			console.log('停止录音异常====>', e);
		}

		// 设置标志，让读取线程退出循环
		isRecording = false;

		// 等待线程结束
		const localThread = recordingThread;
		if (localThread != null) {
			try {
				localThread.join(1000);
			} catch (e : any) {
				// 忽略
			}
			recordingThread = null;
		}

		// 释放资源（必须在 stop() 之后调用）
		try {
			localAudioRecord.release();
			console.log('AudioRecord.release() 已调用');
		} catch (e : any) {
			// 忽略释放时的异常
			console.log('释放资源异常====>', e);
		}
		audioRecord = null;

		frameCallback = null;
		recordFrameSize = 0;

		// 计算录音时长
		const duration = Date.now() - startTime;

		const res : StopRecordResult = {
			success: true,
			duration: duration
		};
		options?.success?.(res);
		options?.complete?.(res);

	} catch (e : any) {
		const err = new RecordFailImpl(9010004);
		options?.fail?.(err);
		options?.complete?.(err);
	}
}

/**
 * 更多插件开发的信息详见：https://uniapp.dcloud.net.cn/plugin/uts-plugin.html
